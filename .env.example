# Change this value before you start the service.
ADMIN_PASSWORD=replace-with-a-strong-admin-passphrase

# Generate a value with: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-characters

# This is the host port. The container always listens on port 3000.
PORT=3000

# Use true only when users access the service through HTTPS.
COOKIE_SECURE=false

# Required when you enable the Docker Compose "tunnel" profile.
# Keep this token secret. Get it from your remotely managed Cloudflare Tunnel.
TUNNEL_TOKEN=
